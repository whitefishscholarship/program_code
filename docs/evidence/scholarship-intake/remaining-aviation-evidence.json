    },
    {
      "sourceId": "official-aviation28-child-donley",
      "url": "https://app.smarterselect.com/programs/94012-Air--Space-Forces-Association",
      "observedAt": "2026-09-11T07:18:53Z",
      "observationPrecision": "End of reviewer-reported20-request observation window, not exact individual response time",
      "observationWindow": {
        "start": "2026-09-11T07:16:54Z",
        "end": "2026-09-11T07:18:53Z"
      },
      "excerpt": "Donley Spouse Scholarship offers3000 to a spouse of eligible Air Force/Space Force personnel or Department of the Air Force civilian employee. Spouses themselves serving in Air/Space Force or ROTC are excluded. Degree programs qualify; certificates do not. The ordinary academic requirements are cumulative3.5GPA and at least six undergraduate or three graduate credits, with transcript; non-enrolled applicants provide transcript plus institutional intent letter. The rules expressly permit proof of acceptance if no prior college coursework exists, but do not clarify how3.5applies to that alternative. Therefore no universalGPAfilter is proposed. Submit goals/motivation and Air/Space Force/community-involvement essay and recommendation via the named SmarterSelect record. Funds may support tuition, books, fees, transport or daycare. DeadlineApril30,2026at11:59p.m.EDT is closed; future cycle and renewal are unverified. Recipients must supply aW-9 beforedisbursement;no suchmaterialaccessed.",
      "contentSha256": "fc4e6cc9b0e9fe55fa392b32ee60b3c90a2eaa02ad80846f4eb58d0c61b5c6cc"
    },
    {
      "sourceId": "official-aviation28-child-lindsay",
      "url": "https://app.smarterselect.com/programs/94005-Air--Space-Forces-Association",
      "observedAt": "2026-09-11T07:18:53Z",
