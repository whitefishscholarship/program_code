    ],
    "hardConflictMinimum": "accepted_field_specific_authority",
    "conflictPolicy": "conflict_blocks_acceptance_and_matching_use",
    "rules": [
      "cycle-specific child-award evidence outranks parent or yearless evidence for the same field",
      "an organizer-reviewed master fact may be accepted directly only when the organizer is the authoritative owner for that local award field",
      "material eligibility, deadline, cycle, and application facts otherwise require current official provider evidence",
      "secondary sources and AI output may discover or propose but can never establish accepted truth",
      "equal-authority disagreement becomes conflict until a human reviewer records a source-specific resolution"
    ]
  },
  "sensitivePolicy": {
    "nonselectionMeaning": "unknown_not_negative",
    "unansweredMeaning": "unknown_not_negative",
    "acceptedUse": "positive_signal_only_unless_explicit_contradiction",
    "rules": [
      "health, disability, heritage, identity, hardship, affiliation, employer, financial, citizenship, and caregiving inputs remain optional",
      "prefer-not-to-answer is equivalent to unanswered for matching",
      "only an explicit contradictory typed answer plus an accepted required fact may create a known conflict",
      "a positive selection may rank or match only when exact accepted authority exists"
    ]
  },
  "freshness": {
    "cycleSpecific": "stale_at_cycle_close_or_when_source_declares_replacement",
    "annualRollover": "yearless_or_prior_cycle_fact_stale_on_next_calendar_year_until_reverified",
    "nonCycleReviewDays": 365,
    "rules": [
      "closed, ended, replaced, or superseded cycle evidence is stale for future-cycle matching",
      "annual language without a verified year remains unknown and cannot establish current availability",
      "a retrieval success does not reset freshness unless the material field is re-observed",
      "stale facts remain visible to review but unavailable to matching"
    ]
  },
  "claudeBoundary": {
    "role": "proposal_only",
    "outputStatus": "proposed",
    "directWriteAllowed": false,
    "selfAcceptanceAllowed": false,
    "requiredReceipts": [
      "input_fingerprint",
      "prompt_version",
      "batch_identity",
      "checkpoint",
      "resume_cursor",
      "completeness",
      "output_fingerprint",
      "ambiguity_counts"
    ],
    "rules": [
      "run only after a later accepted kickoff grants exact source and processing authority",
      "consume revision-pinned bounded inputs and only separately authorized official sources",
      "emit schema-valid JSON or JSONL with provenance, confidence, and ambiguity",
      "never process applicant PII, enter an application, contact a provider, silently truncate work, or write a spreadsheet"
    ]
  },
  "codexBoundary": {
    "role": "governance_validation_reconciliation_owner",
    "responsibilities": [
      "stable_id_binding",
      "duplicate_conflict_coverage_checks",
      "no_truncation_reconciliation",
      "source_evidence_policy",
      "proposal_review",
      "independent_review_packaging",
      "separately_authorized_write_control"
    ]
  },
  "futureWriteGate": {
    "editAccessIsAuthority": false,
    "requiredAuthorityFields": [
      "spreadsheet_id",
      "tab",
      "columns_ranges_cells",
      "operation_count",
      "source_revision",
      "backup_owner",
      "rollback_owner"
    ],
    "requiredControls": [
      "verified_backup",
      "deterministic_dry_run",
      "human_acceptance",
      "independent_review",
      "idempotent_bounded_batch",
      "immediate_readback",
      "untargeted_cell_proof",
      "complete_reconciliation"
    ]
  }
}
