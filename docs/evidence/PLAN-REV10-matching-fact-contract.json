{
  "schemaVersion": 1,
  "contractId": "matching-facts-v1",
  "taxonomyVersion": "1.0.0",
  "status": "governance-frozen-no-processing-authority",
  "validatorModulePath": "web/scripts/matching-fact-contract.ts",
  "subjectIdentity": {
    "required": [
      "award_id"
    ],
    "optional": [
      "cycle_id"
    ],
    "distinctEntities": [
      "parent_source",
      "child_award",
      "application_group",
      "annual_cycle"
    ],
    "rules": [
      "award_id must resolve to one accepted canonical award identity and may never be a scholarship name alone",
      "cycle_id is required for a cycle-specific fact and must resolve to a cycle belonging to award_id",
      "parent sources, child awards, shared applications, and cycles never collapse into one identifier",
      "a fact attached to a parent or application group cannot silently become a child-award eligibility fact"
    ]
  },
  "factSchema": {
    "requiredFields": [
      "award_id",
      "cycle_id",
      "criterion_id",
      "effect",
      "operator",
      "value",
      "evidence_status",
      "source_url",
      "source_revision",
      "observed_at",
      "evidence_excerpt",
      "reviewer_id",
      "reviewed_at",
      "review_rationale",
      "taxonomy_version"
    ],
    "effects": [
      "required",
      "preferred",
      "informational"
    ],
    "evidenceStatuses": [
      "proposed",
      "accepted",
      "rejected",
      "conflict",
      "stale",
      "unknown"
    ],
    "valueTypes": [
      "boolean",
      "number",
      "integer",
      "string",
      "date",
      "enum",
      "enum_set",
      "identifier",
      "identifier_set"
    ],
    "operators": [
      {
        "id": "eq",
        "valueTypes": [
          "boolean",
          "number",
          "integer",
          "string",
          "date",
          "enum",
          "identifier"
        ]
      },
      {
        "id": "neq",
        "valueTypes": [
          "boolean",
          "number",
          "integer",
          "string",
          "date",
          "enum",
          "identifier"
        ]
      },
      {
        "id": "in",
        "valueTypes": [
          "enum_set",
          "identifier_set"
        ]
      },
      {
        "id": "not_in",
        "valueTypes": [
          "enum_set",
          "identifier_set"
        ]
      },
      {
        "id": "gte",
        "valueTypes": [
          "number",
          "integer",
          "date"
        ]
      },
      {
        "id": "lte",
        "valueTypes": [
          "number",
          "integer",
          "date"
        ]
      },
      {
        "id": "between",
        "valueTypes": [
          "number",
          "integer",
          "date"
        ]
      },
      {
        "id": "contains_any",
        "valueTypes": [
          "enum_set",
          "identifier_set"
        ]
      },
      {
        "id": "contains_all",
        "valueTypes": [
          "enum_set",
          "identifier_set"
        ]
      },
      {
        "id": "exists",
        "valueTypes": [
          "boolean"
        ]
      }
    ],
    "validationAlgorithm": "matching-facts-v1-strict",
    "unknownFields": "reject",
    "fieldSchemas": {
      "award_id": { "jsonType": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
      "cycle_id": { "jsonType": ["string", "null"], "patternWhenString": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
      "criterion_id": { "jsonType": "string", "closedDomain": "criteria[].criterion_id" },
      "effect": { "jsonType": "string", "closedDomain": "factSchema.effects" },
      "operator": { "jsonType": "string", "closedDomain": "criterion.allowed_operators" },
      "evidence_status": { "jsonType": "string", "closedDomain": "factSchema.evidenceStatuses" },
      "source_url": { "jsonType": ["string", "null"], "protocols": ["https", "http"], "maxLength": 2048 },
      "source_revision": { "jsonType": ["string", "null"], "minLength": 1, "maxLength": 256 },
      "observed_at": { "jsonType": ["string", "null"], "format": "date-time-utc" },
      "evidence_excerpt": { "jsonType": ["string", "null"], "minLength": 1, "maxLength": 500, "pii": "prohibited" },
      "reviewer_id": { "jsonType": ["string", "null"], "patternWhenString": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
      "reviewed_at": { "jsonType": ["string", "null"], "format": "date-time-utc" },
      "review_rationale": { "jsonType": ["string", "null"], "minLength": 1, "maxLength": 500 },
      "taxonomy_version": { "const": "1.0.0" }
    },
    "scalarSchemas": {
      "boolean": { "jsonType": "boolean" },
      "number": { "jsonType": "number", "finite": true },
      "integer": { "jsonType": "integer" },
      "string": { "jsonType": "string", "minLength": 1, "maxLength": 500 },
      "date": { "jsonType": "string", "format": "full-date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "enum": { "jsonType": "string", "domainRequiredByCriterion": true },
      "identifier": { "jsonType": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
      "enum_set": { "jsonType": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "domainRequiredByCriterion": true },
      "identifier_set": { "jsonType": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "itemPattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" }
    },
    "operatorValueEncoding": {
      "eq": "criterion_scalar",
      "neq": "criterion_scalar",
      "gte": "criterion_scalar",
      "lte": "criterion_scalar",
      "in": "criterion_set",
      "not_in": "criterion_set",
      "contains_any": "criterion_set",
      "contains_all": "criterion_set",
      "exists": { "jsonType": "boolean", "meaning": "criterion value is explicitly present when true and explicitly absent only when false is supported by accepted evidence" },
      "between": {
        "jsonType": "object",
        "required": ["lower", "upper", "lower_inclusive", "upper_inclusive"],
        "additionalProperties": false,
        "boundsUseCriterionScalarType": true,
        "ordering": "lower_lte_upper",
        "inclusiveFlagsType": "boolean"
      }
    },
    "numericConstraints": {
      "academic.gpa_unweighted": { "minimum": 0, "maximum": 4, "unit": "grade_points_unweighted" },
      "academic.gpa_weighted": { "minimum": 0, "maximum": 6, "unit": "grade_points_weighted" },
      "academic.class_rank_percentile": { "minimum": 0, "maximum": 100, "unit": "percentile" },
      "academic.sat_total": { "minimum": 400, "maximum": 1600, "unit": "sat_points" },
      "academic.act_composite": { "minimum": 1, "maximum": 36, "unit": "act_points" },
      "service.volunteer_hours": { "minimum": 0, "maximum": 100000, "unit": "hours" },
      "cycle.year": { "minimum": 2000, "maximum": 2100, "unit": "calendar_year" },
      "cycle.award_amount": { "minimum": 0, "maximum": 1000000000, "unit": "usd" }
    },
    "enumDomains": {
      "education.current_status": ["high_school_student", "high_school_senior", "gap_year", "undergraduate", "graduate", "vocational_trade", "other"],
      "education.grade_level": ["grade_9", "grade_10", "grade_11", "grade_12", "postsecondary_year_1", "postsecondary_year_2", "postsecondary_year_3", "postsecondary_year_4_plus"],
      "education.school_type": ["two_year", "four_year", "trade_vocational", "certificate", "other_accredited"],
      "education.target_institution_type": ["two_year", "four_year", "trade_vocational", "certificate", "other_accredited"],
      "geography.residence_state": ["AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "DC", "FL", "GA", "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY", "AS", "GU", "MP", "PR", "VI"],
      "geography.citizenship_status": ["us_citizen", "us_national", "permanent_resident", "eligible_noncitizen", "daca", "international", "other"],
      "financial.income_band": ["under_30000", "30000_49999", "50000_74999", "75000_99999", "100000_149999", "150000_plus"],
      "identity.race_ethnicity": ["american_indian_alaska_native", "asian", "black_african_american", "hispanic_latino", "middle_eastern_north_african", "native_hawaiian_pacific_islander", "white", "multiracial", "other"],
      "identity.gender": ["woman", "man", "nonbinary", "another_identity"],
      "affiliation.military_veteran": ["self", "parent", "spouse", "child", "grandparent", "household_member", "eligible_relationship_unspecified"],
      "affiliation.first_responder": ["self", "parent", "spouse", "child", "grandparent", "household_member", "eligible_relationship_unspecified"],
      "affiliation.farmers_union": ["self", "parent", "spouse", "child", "grandparent", "household_member", "eligible_relationship_unspecified"],
      "affiliation.electric_coop": ["self", "parent", "spouse", "child", "grandparent", "household_member", "eligible_relationship_unspecified"],
      "affiliation.credit_union": ["self", "parent", "spouse", "child", "grandparent", "household_member", "eligible_relationship_unspecified"],
      "affiliation.elks_lodge": ["self", "parent", "spouse", "child", "grandparent", "household_member", "eligible_relationship_unspecified"],
      "affiliation.company_employee": ["self", "parent", "spouse", "child", "grandparent", "household_member", "eligible_relationship_unspecified"],
      "application.mode": ["organizer_common", "provider_portal", "provider_form", "paper", "email", "automatic_consideration", "other"],
      "cycle.status": ["not_open", "open", "closed", "rolling", "suspended", "unknown"],
      "cycle.recurrence": ["annual", "one_time", "rolling", "irregular", "unknown"]
    },
    "statusRules": {
      "proposed": { "value": "typed_non_null", "sourceFields": "required_non_null", "reviewerFields": "all_null", "matchingAvailable": false },
      "accepted": { "value": "typed_non_null", "sourceFields": "required_non_null", "reviewerFields": "required_non_null", "matchingAvailable": true },
      "rejected": { "value": "typed_non_null", "sourceFields": "required_non_null", "reviewerFields": "required_non_null", "matchingAvailable": false },
      "conflict": { "value": "null", "sourceFields": "required_non_null", "reviewerFields": "required_non_null", "matchingAvailable": false },
      "stale": { "value": "typed_non_null", "sourceFields": "required_non_null", "reviewerFields": "required_non_null", "matchingAvailable": false },
      "unknown": { "value": "null", "sourceFields": "nullable_as_group", "reviewerFields": "nullable_as_group", "matchingAvailable": false }
    },
    "statusFieldGroups": {
      "sourceFields": ["source_url", "source_revision", "observed_at", "evidence_excerpt"],
      "reviewerFields": ["reviewer_id", "reviewed_at", "review_rationale"]
    },
    "nullRules": [
      "null, empty, omitted, ambiguous, and unparseable are unknown rather than false",
      "unknown values cannot use neq, not_in, or any negative interpretation",
      "a proposed, rejected, conflict, stale, or unknown fact is unavailable to matching",
      "effect describes provider language and does not override evidence status"
    ]
  },
